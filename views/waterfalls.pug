
extends layout

block content
  h1= title

  -
    let results = [
      { name: "Niagara Falls", country: "Canada", height: 51 },
      { name: "Angel Falls", country: "Venezuela", height: 979 },
      { name: "Victoria Falls", country: "Zimbabwe", height: 108 }
    ]

  div.container-fluid
    div.row
      each item, index in results
        div.col-sm-2(onclick=`buy(${index})`, style="cursor: pointer;")
          p Name: #{item.name}
          p Country: #{item.country}
          p Height: #{item.height} meters

  script.
    function buy(index) {
      alert(`You purchased item ${index}`);
    }
