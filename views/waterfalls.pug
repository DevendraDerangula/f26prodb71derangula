
extends layout

block content
  h1= title

  div.container-fluid
    div.row
      each item, index in results
        div.col-sm-2(onclick=`buy(${index})`, style="cursor: pointer;")
          p Name: #{item.name}
          p Country: #{item.country}
          p Height: #{item.height} meters

  script.
    function buy(index) {
      alert(`You purchased item ${index}`);
    }
